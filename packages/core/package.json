{
  "name": "@leksy/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./db": { "types": "./dist/db/index.d.ts", "default": "./dist/db/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@leksy/bill-schema": "workspace:*",
    "@leksy/mapper": "workspace:*",
    "@leksy/template-engine": "workspace:*",
    "bullmq": "^5.56.0",
    "drizzle-orm": "^0.44.0",
    "ioredis": "^5.6.1",
    "nodemailer": "^7.0.5",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.4",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.31.4"
  }
}
