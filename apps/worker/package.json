{
  "name": "@leksy/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@leksy/bill-schema": "workspace:*",
    "@leksy/core": "workspace:*",
    "bullmq": "^5.56.0",
    "drizzle-orm": "^0.44.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "tsx": "^4.20.3"
  }
}
