{
  "name": "@leksy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@leksy/bill-schema": "workspace:*",
    "@leksy/core": "workspace:*",
    "@leksy/mapper": "workspace:*",
    "@leksy/template-engine": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.4.0",
    "ioredis": "^5.6.1",
    "playwright-core": "^1.54.0",
    "zod": "^4.1.0",
    "@leksy/survey": "workspace:*"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "tsx": "^4.20.3"
  }
}
