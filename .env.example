# --- Core ---
NODE_ENV=development
DATABASE_URL=postgres://leksy:leksy@localhost:5432/leksy
REDIS_URL=redis://localhost:6379
# Public base URL for bill links sent to customers (short domain in production)
PUBLIC_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
JWT_SECRET=change-me-to-at-least-32-random-characters
COOKIE_SECRET=change-me-to-at-least-32-random-characters
# Encrypts stored brand-API credentials (AES-256-GCM). Required in production.
# Generate with: openssl rand -hex 32
LEKSY_SECRETS_KEY=
# Proxies allowed to set X-Forwarded-For (client IPs drive rate limits).
TRUST_PROXY=loopback,linklocal,uniquelocal

# --- Rendering ---
# Path to Chromium for PDFs (the API Docker image sets this)
CHROMIUM_PATH=

# --- Messaging (leave empty in development: messages are logged, not sent) ---
CHANNELS_DRY_RUN=true
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=leksy-dev-verify
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Leksy <bills@leksy.in>

# Allow pull connectors and webhooks to call http:// and private addresses (dev only)
ALLOW_PRIVATE_URLS=true
